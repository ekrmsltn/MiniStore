# Telegram Bot
BOT_TOKEN=your_bot_token_here

# Telegram API credentials (for reading channel history)
API_ID=your_api_id
API_HASH=your_api_hash
# Generate first with `cd bot && npm run mtproto:login`; required to run the bot
TELEGRAM_USER_SESSION=

# Channel IDs (use negative numbers for private channels)
STORAGE_CHANNEL_ID=-1001234567890
MANAGEMENT_CHANNEL_ID=-1000987654321

# Owner Telegram user ID (numeric)
OWNER_ID=123456789

# Server
PORT=3000
NODE_ENV=development
# Required to run the bot. Set WEBHOOK_URL to your public HTTPS address,
# ending in /telegram/webhook, then generate WEBHOOK_SECRET with
# `openssl rand -hex 32`. Keep the secret private.
WEBHOOK_URL=https://your-service.example.com/telegram/webhook
WEBHOOK_SECRET=replace_with_your_generated_secret
# Optional Pino log level
LOG_LEVEL=info

# Required AI assistant provider configuration. Replace all three values.
AI_BASE_URL=https://api.example.com/v1
API_KEY=replace_with_your_provider_key
AI_MODEL=replace_with_a_model_identifier
# For a provider's native Anthropic Messages API, set AI_API_FORMAT=anthropic.
AI_API_FORMAT=openai-compatible
